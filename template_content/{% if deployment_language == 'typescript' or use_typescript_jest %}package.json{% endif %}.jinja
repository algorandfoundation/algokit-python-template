{
  "name": "smart_contracts",
  "version": "1.0.0",
  "description": "Smart contract deployer",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "deploy": "tsx watch --watch .env -r dotenv/config smart_contracts/index.ts",
    "deploy:ci": "tsx -r dotenv/config smart_contracts/index.ts",
    {%- if use_typescript_jest  %}
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    {%- endif %}
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20.0",
    "npm": ">=9.0"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^10.0.0-alpha.40",
    "@algorandfoundation/algokit-utils-debug": "^2.0.0-alpha.2"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "^7.0.0-alpha.5",
    {%- if use_typescript_jest  %}
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    {%- endif %}
    "dotenv": "^16.0.3",
    "prettier": "^2.8.4",
    {%- if use_typescript_jest  %}
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    {%- endif %}
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
